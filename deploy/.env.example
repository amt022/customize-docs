# Copy to deploy/.env on the server and fill in. Never commit .env (it is in .gitignore).

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels > Create > Cloudflared > copy the token)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Required
# python3 -c "import secrets; print(secrets.token_hex(32))"
PDFMASTER_SECRET=
PDFMASTER_CORS=
# files of people who did not sign in
PDFMASTER_RETENTION_HOURS=24
# 0 = signed-in users keep files until they delete them
PDFMASTER_ACCOUNT_RETENTION_DAYS=0
PDFMASTER_TRASH_DAYS=30

# --- Who runs the site (shown on Privacy / Terms; the server will not start without the first two)
PDFMASTER_OPERATOR=
PDFMASTER_GRIEVANCE_EMAIL=
PDFMASTER_GRIEVANCE_NAME=
PDFMASTER_ADDRESS=
PDFMASTER_DATA_REGION=India

# --- Sign-in codes by email (docs/DEPLOYMENT.md section 2)
PDFMASTER_EMAIL=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FormEasy <no-reply@example.in>

# --- Optional: SMS sign-in (section 2b)
# PDFMASTER_SMS=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# --- Optional: keep documents in Cloudflare R2 instead of the server disk
# PDFMASTER_STORAGE=s3
# PDFMASTER_S3_BUCKET=formeasy-docs
# PDFMASTER_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# PDFMASTER_S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Optional: AI assistant
# ANTHROPIC_API_KEY=

# 2 workers suit a 2-CPU / 4 GB server
WEB_CONCURRENCY=2

# Cloudflare free plan blocks uploads above 100 MB
PDFMASTER_MAX_UPLOAD_MB=95
